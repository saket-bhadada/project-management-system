# Server configuration (copy to .env and fill in your credentials)

# HTTP/WebSocket port the Express app will listen on.  Do **not** reuse the
# same value as your database port!  Defaults to 3000 if unset.
SERVER_PORT=3000

# Credentials for PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_DATABASE=mydatabase

# Session secret (change in production)
SESSION_SECRET=dev-session-secret

# Client origin allowed by CORS (frontend dev server)
CLIENT_URL=http://localhost:5173
